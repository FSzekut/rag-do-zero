# Copie para .env SÓ para rodar no seu computador. O .env nunca é versionado.
# Em produção, as chaves vivem nos Secrets do Space e do GitHub — nunca neste arquivo.
#
# Modelos de IA (parte 1). Basta UMA delas para o app funcionar.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Base de consulta no Supabase (parte 2).
# A URL termina em .supabase.co (painel: Project Settings, API Keys).
SUPABASE_URL=
# A chave SECRETA grava no banco: só roda no GitHub Actions e aqui, no seu
# computador, para indexar e avaliar. NUNCA vai para o Space.
SUPABASE_SECRET_KEY=
# A chave PUBLICÁVEL só lê (a coleção de produção): é a do Space.
SUPABASE_PUBLISHABLE_KEY=
